{
  "manifest_version": 3,
  "name": "Chat Everywhere",
  "version": "3.0",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
